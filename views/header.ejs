<header class="topbar">
    <div class="header-left">
        <h1>Robolx</h1>
        <span class="greeting-label">Good morning</span>
    </div>

    <div class="theme-switcher" aria-label="Theme switcher" role="menu">
        <button class="theme-option is-active" data-theme="navy" type="button" aria-label="Navy theme">Navy</button>
        <button class="theme-option" data-theme="navy-dark" type="button" aria-label="Dark navy theme">Navy Night</button>
        <button class="theme-option" data-theme="red" type="button" aria-label="Red theme">Red</button>
        <button class="theme-option" data-theme="red-dark" type="button" aria-label="Dark red theme">Red Night</button>
        <button class="theme-option" data-theme="green" type="button" aria-label="Green theme">Green</button>
        <button class="theme-option" data-theme="green-dark" type="button" aria-label="Dark green theme">Green Night</button>
        <button class="theme-option" data-theme="gold" type="button" aria-label="Gold theme">Gold</button>
        <button class="theme-option" data-theme="gold-dark" type="button" aria-label="Dark gold theme">Gold Night</button>
    </div>
</header>