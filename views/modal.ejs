<div class="modal">
    <div class="modal-content">
        <form id="add-ad-form">
            <button type="button" class="close" data-dismiss="modal">x</button>
            <h1>Add Advertisement</h1>
            <label for="ad-title">Title:</label>
            <input type="text" id="ad-title" name="ad-title" required> 
            <label for="ad-description">Description:</label>
            <textarea id="ad-description" name="ad-description" required></textarea>
            <label for="image" class="image-label">Upload Image:</label>
            <input type="file" name="image" id="image" required multiple accept="image/*">
            <button type="submit">Add Advertisement</button>
        </form>
    </div>
</div>